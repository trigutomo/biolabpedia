---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PILLAR_LIST } from '../../content.config';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    pillar: entry.data.pillar,
    publishedAt: entry.data.publishedAt.toISOString(),
    updatedAt: entry.data.updatedAt?.toISOString() ?? null,
    tags: entry.data.tags,
    href: `/artikel/${entry.id}/`,
  }));

const fmt = (d: Date) =>
  d.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Semua Artikel"
  description="Tentang alat, teknik, bahan, dan praktik laboratorium biologi."
>
  <section class="article-index-hero">
    <div class="container">
      <h1>Semua Artikel</h1>
      <p>Tentang alat, teknik, bahan, dan praktik laboratorium biologi.</p>
    </div>
  </section>

  <section class="section article-index-section">
    <div class="container">
      <div class="controls article-index-controls">
        <input
          type="search"
          id="search-input"
          placeholder="Cari artikel…"
          aria-label="Cari artikel"
        />
        <div class="filter-group" id="filter-group" role="group" aria-label="Filter kategori">
          <button class="filter-btn" type="button" data-pillar="all" aria-pressed="true">Semua</button>
          {
            PILLAR_LIST.map((pillar) => (
              <button class="filter-btn" type="button" data-pillar={pillar.id} aria-pressed="false">
                {pillar.short}
              </button>
            ))
          }
        </div>
      </div>

      <p id="result-count" aria-live="polite"></p>

      <ul class="article-list" id="article-list">
        {
          articles.map((article) => (
            <li
              data-article
              data-pillar={article.pillar}
              data-search={`${article.title} ${article.description} ${article.tags.join(' ')}`.toLowerCase()}
            >
              <article class="article-row">
                <h3>
                  <a href={article.href}>{article.title}</a>
                </h3>
                <p>{article.description}</p>
                <p class="meta">
                  <span>Terbit {fmt(new Date(article.publishedAt))}</span>
                  {article.updatedAt && <span>Diperbarui {fmt(new Date(article.updatedAt))}</span>}
                </p>
              </article>
            </li>
          ))
        }
      </ul>

      <div class="no-results" id="no-results" hidden>
        Tidak ada artikel yang cocok. Coba kata kunci lain atau pilih kategori “Semua”.
      </div>

      <nav class="article-pagination" id="article-pagination" aria-label="Halaman artikel" hidden></nav>
    </div>
  </section>

  <script is:inline>
    (function () {
      const input = document.getElementById('search-input');
      const buttons = document.querySelectorAll('.filter-btn');
      const items = document.querySelectorAll('[data-article]');
      const count = document.getElementById('result-count');
      const empty = document.getElementById('no-results');
      const pagination = document.getElementById('article-pagination');
      const pageSize = 10;

      let activePillar = 'all';
      let activePage = 1;

      const params = new URLSearchParams(window.location.search);
      const initialPillar = params.get('pillar');
      const initialPage = Number.parseInt(params.get('page') || '1', 10);
      if (Number.isFinite(initialPage) && initialPage > 0) activePage = initialPage;
      if (initialPillar) {
        const match = Array.from(buttons).find((b) => b.dataset.pillar === initialPillar);
        if (match) activePillar = initialPillar;
      }

      function addPageButton(label, ariaLabel, page, className, disabled) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = className;
        button.textContent = label;
        button.setAttribute('aria-label', ariaLabel);
        button.disabled = disabled;
        button.addEventListener('click', function () {
          activePage = page;
          apply();
          document.getElementById('article-list').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        pagination.appendChild(button);
      }

      function renderPagination(totalPages) {
        pagination.replaceChildren();
        pagination.hidden = totalPages <= 1;
        if (totalPages <= 1) return;

        addPageButton('‹', 'Halaman sebelumnya', Math.max(1, activePage - 1), 'article-pagination__step', activePage === 1);
        for (let page = 1; page <= totalPages; page += 1) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'article-pagination__number';
          button.textContent = String(page);
          button.setAttribute('aria-label', 'Halaman ' + page);
          if (page === activePage) {
            button.setAttribute('aria-current', 'page');
            button.disabled = true;
          } else {
            button.addEventListener('click', function () {
              activePage = page;
              apply();
              document.getElementById('article-list').scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
          }
          pagination.appendChild(button);
        }
        addPageButton('›', 'Halaman berikutnya', Math.min(totalPages, activePage + 1), 'article-pagination__step', activePage === totalPages);
      }

      function apply() {
        const query = (input.value || '').trim().toLowerCase();
        const matchedItems = [];

        items.forEach(function (item) {
          const matchPillar = activePillar === 'all' || item.dataset.pillar === activePillar;
          const matchQuery = !query || item.dataset.search.includes(query);
          item.hidden = true;
          if (matchPillar && matchQuery) matchedItems.push(item);
        });

        const totalPages = Math.max(1, Math.ceil(matchedItems.length / pageSize));
        if (activePage > totalPages) activePage = totalPages;
        const start = (activePage - 1) * pageSize;
        const pageItems = matchedItems.slice(start, start + pageSize);
        pageItems.forEach((item) => { item.hidden = false; });

        const firstResult = matchedItems.length ? start + 1 : 0;
        const lastResult = Math.min(start + pageSize, matchedItems.length);
        count.textContent = matchedItems.length
          ? 'Menampilkan ' + firstResult + '–' + lastResult + ' dari ' + matchedItems.length + ' artikel'
          : '0 artikel ditemukan';
        empty.hidden = matchedItems.length > 0;
        renderPagination(totalPages);

        buttons.forEach(function (btn) {
          btn.setAttribute('aria-pressed', String(btn.dataset.pillar === activePillar));
        });

        const url = new URL(window.location.href);
        if (activePillar === 'all') url.searchParams.delete('pillar');
        else url.searchParams.set('pillar', activePillar);
        if (activePage === 1) url.searchParams.delete('page');
        else url.searchParams.set('page', String(activePage));
        history.replaceState(null, '', url);
      }

      input.addEventListener('input', function () {
        activePage = 1;
        apply();
      });
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          activePillar = btn.dataset.pillar;
          activePage = 1;
          apply();
        });
      });

      apply();
    })();
  </script>
</section>
