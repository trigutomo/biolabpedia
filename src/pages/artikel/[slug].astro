---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const all = await getCollection('articles');
const related = all
  .filter((a) => a.id !== entry.id && a.data.pillar === entry.data.pillar)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const fallbackRelated =
  related.length > 0
    ? related
    : all
        .filter((a) => a.id !== entry.id)
        .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
        .slice(0, 3);

const fmt = (d: Date) => d.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
>
  <div class="reading-progress" id="reading-progress"></div>
  
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Beranda</a>
    <span class="separator">›</span>
    <a href="/artikel/">Artikel</a>
    <span class="separator">›</span>
    <span>{entry.data.title}</span>
  </nav>

  <article>
    <header class="article-header">
      <div class="container">
        <h1>{entry.data.title}</h1>
        <p class="summary">{entry.data.description}</p>
        <p class="meta">
          <span>{entry.data.author ?? 'Redaksi Biolabpedia'}</span>
          <span>Terbit {fmt(entry.data.publishedAt)}</span>
          {entry.data.updatedAt && <span>Diperbarui {fmt(entry.data.updatedAt)}</span>}
          {entry.data.readingTime && <span>{entry.data.readingTime} min read</span>}
          {entry.data.tags.length > 0 && <span>Tag: {entry.data.tags.join(', ')}</span>}
        </p>
      </div>
    </header>

    <div class="container">
      <div class="prose">
        <div class="disclaimer">
          Panduan pada artikel ini bersifat umum. Prosedur, parameter, dan langkah keselamatan
          dapat berbeda menurut model alat, sampel, protokol, serta peraturan laboratorium
          masing-masing. Selalu rujuk manual produsen, SOP setempat, dan SDS bahan yang digunakan.
        </div>
        <Content />
      </div>

      {
        entry.data.sources.length > 0 && (
          <aside class="sources">
            <h2>Sumber</h2>
            <ol>
              {entry.data.sources.map((s) => (
                <li>
                  {s.url ? <a href={s.url} rel="noopener noreferrer">{s.label}</a> : s.label}
                </li>
              ))}
            </ol>
          </aside>
        )
      }

      {
        fallbackRelated.length > 0 && (
          <section class="related">
            <h2>Artikel terkait</h2>
            <div class="grid grid-3">
              {fallbackRelated.map((rel) => (
                <ArticleCard
                  title={rel.data.title}
                  description={rel.data.description}
                  href={`/artikel/${rel.id}/`}
                  publishedAt={rel.data.publishedAt}
                  updatedAt={rel.data.updatedAt}
                />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>

  <script is:inline>
    (function () {
      const progressBar = document.getElementById('reading-progress');
      const article = document.querySelector('.prose');
      if (!progressBar || !article) return;

      function updateProgress() {
        const articleTop = article.offsetTop;
        const articleHeight = article.offsetHeight;
        const windowHeight = window.innerHeight;
        const scrollY = window.scrollY;

        const progress = Math.min(100, Math.max(0, ((scrollY - articleTop + windowHeight / 2) / articleHeight) * 100));
        progressBar.style.width = progress + '%';
      }

      window.addEventListener('scroll', updateProgress);
      updateProgress();
    })();
  </script>
</BaseLayout>
