---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman tidak ditemukan" description="Halaman yang Anda cari tidak ada di Biolabpedia.">
  <section class="hero">
    <div class="container">
      <span class="kicker">404</span>
      <h1>Halaman tidak ditemukan</h1>
      <p class="lead">Tautan yang Anda buka tidak tersedia. Coba mulai dari beranda atau arsip artikel.</p>
      <div class="hero-actions">
        <a class="btn" href="/">Beranda</a>
        <a class="btn btn-outline" href="/artikel/">Arsip artikel</a>
      </div>
    </div>
  </section>
</BaseLayout>
