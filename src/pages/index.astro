---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeStoryCard from '../components/HomeStoryCard.astro';
import HomeAdSlot from '../components/HomeAdSlot.astro';
import { PILLAR_LIST } from '../content.config';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const lead = articles.find((article) => article.data.featured) ?? articles[0];
const sideStories = articles.filter((article) => article.id !== lead?.id).slice(0, 4);
const latest = articles.filter((article) => article.id !== lead?.id).slice(0, 6);
const fmt = (d: Date) => d.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });

const pillarDesc: Record<string, string> = {
  'kenali-alat': 'Fungsi, prinsip kerja, dan karakteristik alat-alat laboratorium biologi.',
  'panduan-penggunaan': 'Langkah operasi dan praktik terbaik untuk alat serta prosedur umum.',
  'bahan-habis-pakai': 'Panduan memilih pipette tips, tabung, slide, dan bahan sekali pakai.',
  'perawatan-keselamatan': 'Kebersihan, penyimpanan, dan praktik keselamatan kerja di laboratorium.',
  'teknik-dasar': 'Teknik inti laboratorium seperti pipetting, sentrifus, dan preparasi sampel.',
  'pemecahan-masalah': 'Kenali gejala, cari penyebab, dan atasi masalah laboratorium yang umum.',
};

const imageFor = (pillar: string) => {
  if (pillar === 'panduan-penggunaan' || pillar === 'bahan-habis-pakai' || pillar === 'teknik-dasar') {
    return '/images/home-pipetting.png';
  }
  if (pillar === 'perawatan-keselamatan' || pillar === 'pemecahan-masalah') {
    return '/images/home-lab-safety.png';
  }
  return '/images/home-microscope.png';
};

const pillarSections = PILLAR_LIST.map((pillar) => ({
  pillar,
  articles: articles.filter((article) => article.data.pillar === pillar.id).slice(0, 3),
})).filter((section) => section.articles.length > 0);
---

<BaseLayout
  title="Biolabpedia"
  description="Biolabpedia adalah media edukasi tentang alat, perlengkapan, teknik, dan praktik laboratorium biologi untuk mahasiswa dan praktisi."
  variant="home"
>
  <HomeAdSlot slot="top-ad" size="billboard" />

  <section class="home-intro">
    <div class="container home-intro__inner">
      <div>
        <span class="home-eyebrow">Media edukasi laboratorium biologi</span>
        <h1>Pengetahuan lab, lebih dekat.</h1>
        <p>Panduan alat, teknik, dan praktik laboratorium yang jelas untuk belajar dan bekerja lebih yakin.</p>
      </div>
      <a class="home-browse-link" href="/artikel/">Jelajahi semua artikel</a>
    </div>
  </section>

  <section class="home-lead-section container" aria-label="Pilihan artikel Biolabpedia">
    <div class="home-feature-grid">
      {
        lead && (
          <article class="home-feature-story">
            <a class="home-feature-story__image" href={`/artikel/${lead.id}/`} aria-label={lead.data.title}>
              <img src="/images/home-lab-feature.png" alt="Peneliti menyiapkan sampel dengan micropipette di laboratorium biologi" fetchpriority="high" />
            </a>
            <div class="home-feature-story__copy">
              <span class="home-story-label">Pilihan redaksi</span>
              <h2><a href={`/artikel/${lead.id}/`}>{lead.data.title}</a></h2>
              <p>{lead.data.description}</p>
              <p class="home-story-meta">
                <span>{lead.data.author}</span>
                <span>Terbit {fmt(lead.data.publishedAt)}</span>
                {lead.data.readingTime && <span>{lead.data.readingTime} menit baca</span>}
              </p>
            </div>
          </article>
        )
      }

      <aside class="home-side-stories" aria-label="Artikel terbaru">
        <div class="home-section-heading home-section-heading--compact">
          <div>
            <span class="home-eyebrow">Dari ruang laboratorium</span>
            <h2>Artikel terbaru</h2>
          </div>
          <a href="/artikel/">Lihat semua</a>
        </div>
        <div class="home-side-stories__grid">
          {
            sideStories.map((article, index) => (
              <HomeStoryCard
                title={article.data.title}
                description={article.data.description}
                href={`/artikel/${article.id}/`}
                image={index === 0 ? '/images/home-pipetting.png' : index === 1 ? '/images/home-microscope.png' : '/images/home-lab-safety.png'}
                imageAlt={`Ilustrasi editorial laboratorium untuk ${article.data.title}`}
                publishedAt={article.data.publishedAt}
                variant="compact"
              />
            ))
          }
        </div>
      </aside>
    </div>
  </section>

  <HomeAdSlot />

  <section class="home-topics container" id="topik" aria-labelledby="home-topics-title">
    <div class="home-section-heading">
      <div>
        <span class="home-eyebrow">Mulai dari yang Anda butuhkan</span>
        <h2 id="home-topics-title">Jelajahi topik</h2>
      </div>
      <a href="/artikel/">Semua panduan</a>
    </div>
    <div class="home-topic-grid">
      {
        PILLAR_LIST.map((pillar, index) => (
          <a class="home-topic-card" href={`/artikel/?pillar=${pillar.id}`}>
            <span class="home-topic-card__number">{String(index + 1).padStart(2, '0')}</span>
            <span class="home-topic-card__title">{pillar.label}</span>
            <span class="home-topic-card__description">{pillarDesc[pillar.id]}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-latest-section" aria-labelledby="home-latest-title">
    <div class="container">
      <div class="home-section-heading">
        <div>
          <span class="home-eyebrow">Pembaruan dari redaksi</span>
          <h2 id="home-latest-title">Bacaan terbaru</h2>
        </div>
        <a href="/artikel/">Lihat seluruh artikel</a>
      </div>
      <div class="home-story-grid home-story-grid--latest">
        {
          latest.map((article) => (
            <HomeStoryCard
              title={article.data.title}
              description={article.data.description}
              href={`/artikel/${article.id}/`}
              image={imageFor(article.data.pillar)}
              imageAlt={`Ilustrasi editorial laboratorium untuk ${article.data.title}`}
              publishedAt={article.data.publishedAt}
              updatedAt={article.data.updatedAt}
            />
          ))
        }
      </div>
    </div>
  </section>

  {
    pillarSections.map(({ pillar, articles: pillarArticles }, index) => (
      <Fragment>
        <section class="home-category-section container" aria-labelledby={`pillar-${pillar.id}`}>
          <div class="home-section-heading">
            <div>
              <h2 id={`pillar-${pillar.id}`}>{pillar.label}</h2>
            </div>
            <a href={`/artikel/?pillar=${pillar.id}`}>Semua artikel</a>
          </div>
          <div class="home-story-grid">
            {
              pillarArticles.map((article) => (
                <HomeStoryCard
                  title={article.data.title}
                  description={article.data.description}
                  href={`/artikel/${article.id}/`}
                  image={imageFor(pillar.id)}
                  imageAlt={`Ilustrasi editorial untuk topik ${pillar.label}`}
                  publishedAt={article.data.publishedAt}
                  updatedAt={article.data.updatedAt}
                />
              ))
            }
          </div>
        </section>
        {(index === 1 || index === 4) && <HomeAdSlot />}
      </Fragment>
    ))
  }
</BaseLayout>
