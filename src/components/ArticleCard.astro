---
interface Props {
  title: string;
  description: string;
  href: string;
  publishedAt: Date;
  updatedAt?: Date;
}

const { title, description, href, publishedAt, updatedAt } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
---

<article class="article-row">
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <p class="meta">
    <span>Terbit {fmt(publishedAt)}</span>
    {updatedAt && <span>Diperbarui {fmt(updatedAt)}</span>}
  </p>
</article>
